<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/app_overlay_card_bg"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/menu_pause"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/app_menu_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:minWidth="120dp"
        android:padding="10dp"
        android:text="暂停录制"
        android:textColor="@color/app_text_primary"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/app_divider" />

    <TextView
        android:id="@+id/menu_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/app_menu_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:minWidth="120dp"
        android:padding="10dp"
        android:text="停止录制"
        android:textColor="@color/app_danger"
        android:textSize="14sp" />
</LinearLayout>

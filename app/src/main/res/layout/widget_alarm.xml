<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="6dp"
    android:background="@drawable/bg_widget_m3">

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/bg_widget_mode_rtc"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:text="@string/alarm_widget_rtc_label"
        android:textColor="@color/widget_on_mode"
        android:textSize="11sp" android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center">

        <TextView
            android:id="@+id/tv_widget_alarm_time"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="--:--"
            android:textColor="@color/widget_on_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_alarm_sub"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:text="@string/alarm_widget_rtc_empty"
            android:textColor="@color/widget_on_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:background="@drawable/widget_pill_solid"
            android:textColor="#0B57D0"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:id="@+id/btn_widget_alarm_minus15"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
            android:layout_marginEnd="2dp"
            android:text="@string/alarm_widget_btn_minus15"
            android:textSize="11sp" />

        <Button
            android:background="@drawable/widget_pill_solid"
            android:textColor="#0B57D0"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:id="@+id/btn_widget_alarm_plus15"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:text="@string/alarm_widget_btn_plus15"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:background="@drawable/widget_pill_solid"
            android:textColor="#0B57D0"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:id="@+id/btn_widget_alarm_minus5"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
            android:layout_marginEnd="2dp"
            android:text="@string/alarm_widget_btn_minus5"
            android:textSize="11sp" />

        <Button
            android:background="@drawable/widget_pill_solid"
            android:textColor="#0B57D0"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:id="@+id/btn_widget_alarm_plus5"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:text="@string/alarm_widget_btn_plus5"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:background="@drawable/widget_pill_solid"
            android:textColor="#0B57D0"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:id="@+id/btn_widget_alarm_pick"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
            android:layout_marginEnd="2dp"
            android:text="@string/alarm_widget_btn_pick"
            android:textSize="11sp" />

        <Button
            android:background="@drawable/widget_pill_solid"
            android:textColor="#0B57D0"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:id="@+id/btn_widget_alarm_cancel"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:text="@string/alarm_widget_btn_cancel"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>

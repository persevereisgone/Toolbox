<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".ui.home.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingBottom="28dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶行:TOOLBOX 黑 pill + 更新日志胶囊 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/home_dev_entry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_pill_dark_bg"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="TOOLBOX"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/home_changelog_entry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/home_pill_blue_bg"
                        android:minHeight="@dimen/button_height"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_lg"
                        android:paddingEnd="@dimen/space_lg"
                        android:text="更新日志"
                        android:textColor="@color/app_nav_checked"
                        android:textSize="@dimen/text_caption_lg"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/home_changelog_badge"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:background="@drawable/home_changelog_badge_bg"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>

            <!-- 标题区 -->
            <TextView
                android:id="@+id/home_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="常用操作，一步即达"
                android:textColor="@color/home_title"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="把常用功能放在最前面，少翻找、少等待。"
                android:textColor="@color/home_subtitle"
                android:textSize="@dimen/text_body_lg" />

            <!-- 搜索框 -->
            <EditText
                android:id="@+id/home_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/home_search_bg"
                android:hint="搜索功能…"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="@dimen/button_height_md"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_tertiary"
                android:textSize="@dimen/text_body_lg" />

            <!-- 常用功能标题行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="常用功能"
                    android:textColor="@color/home_title"
                    android:textSize="@dimen/text_title_lg"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_home_all"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:minWidth="48dp"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_xxs"
                    android:text="全部 ›"
                    android:contentDescription="查看全部功能"
                    android:textColor="@color/app_text_tertiary"
                    android:textSize="@dimen/text_caption_lg" />
            </LinearLayout>

            <!-- 常用功能列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_panel_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- 小贴士深底卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/home_tip_dark_bg"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="使用小贴士"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_body_lg"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:text="点右侧爱心可置顶常用  点“全部”查看所有功能"
                    android:textColor="#FFDFE6F2"
                    android:textSize="@dimen/text_caption_lg" />
            </LinearLayout>

            <!-- 更多功能 BETA -->
            <LinearLayout
                android:id="@+id/beta_section_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/beta_section_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="更多功能"
                        android:textColor="@color/home_title"
                        android:textSize="@dimen/text_title_lg"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/beta_section_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BETA"
                        android:textColor="@color/app_text_tertiary"
                        android:textSize="@dimen/text_caption_lg"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/beta_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

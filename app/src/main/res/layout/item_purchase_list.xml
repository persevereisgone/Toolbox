<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/app_card_stroke"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/purchase_item_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_md">

            <ImageView
                android:id="@+id/iv_purchase_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/tab_purchase"
                android:src="@drawable/ingredients"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_purchase_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_md"
                android:textColor="@color/app_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_purchase_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_primary"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                android:paddingStart="@dimen/space_md" />

            <CheckBox
                android:id="@+id/cb_purchase_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/cookbook_purchased"
                android:textColor="@color/app_text_secondary"
                android:focusable="false"
                android:clickable="true" />

        </LinearLayout>

        <View
            android:id="@+id/view_purchased_strike"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_md"
            android:background="@color/app_text_secondary"
            android:visibility="gone" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/app_hero_bg"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/home_chip_bg"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_xs"
                android:text="STATISTICS"
                android:textColor="@color/app_text_inverse"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="物品统计"
                android:textColor="@color/app_text_inverse"
                android:textSize="@dimen/text_hero"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="快速维护统计组、录入数量并导入导出数据。"
                android:textColor="@color/home_header_subtitle"
                android:textSize="@dimen/text_caption_lg" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Toolbox.CardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Toolbox.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="统计组" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinner_statistics_set"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_md"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:layout_weight="1"
                    android:background="@drawable/app_input_bg"
                    android:paddingStart="@dimen/space_lg" />

                <Button
                    android:id="@+id/btn_manage_sets"
                    style="@style/Widget.Toolbox.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="管理" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Toolbox.CardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Toolbox.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="新增物品" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_item_name"
                    style="@style/Widget.Toolbox.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:layout_weight="1"
                    android:hint="物品名称" />

                <EditText
                    android:id="@+id/et_item_quantity"
                    style="@style/Widget.Toolbox.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:layout_weight="0.55"
                    android:hint="数量"
                    android:inputType="number" />

                <Button
                    android:id="@+id/btn_add_item"
                    style="@style/Widget.Toolbox.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="添加" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_total_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/app_chip_bg"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_sm"
                android:text="总计: 0"
                android:textColor="@color/app_primary_dark"
                android:textSize="@dimen/text_body_lg"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_batch_delete"
                style="@style/Widget.Toolbox.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_lg"
                android:text="批量删除"
                android:textColor="@color/app_danger" />

            <Button
                android:id="@+id/btn_clear_all"
                style="@style/Widget.Toolbox.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一键清空"
                android:textColor="@color/app_danger" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_export"
                style="@style/Widget.Toolbox.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_lg"
                android:layout_weight="1"
                android:text="导出数据" />

            <Button
                android:id="@+id/btn_import"
                style="@style/Widget.Toolbox.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导入数据" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_fullscreen_list"
            style="@style/Widget.Toolbox.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="全屏查看物品列表" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_statistics"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/app_card_bg"
            android:clipToPadding="false"
            android:padding="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
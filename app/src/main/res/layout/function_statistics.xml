<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 标题栏 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="物品统计"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:padding="16dp"/>

    <!-- 统计套选择器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/shape_overlay_bg"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前统计组："
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"/>

        <Spinner
            android:id="@+id/spinner_statistics_set"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_manage_sets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="管理"
            android:textSize="12sp"
            android:background="@drawable/button_ripple"
            android:textColor="@android:color/black"
            android:backgroundTint="@android:color/holo_blue_light"/>

    </LinearLayout>

    <!-- 添加新物品的输入区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/et_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="物品名称"
            android:padding="12dp"
            android:background="@drawable/shape_10_white"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/et_item_quantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:hint="数量"
            android:inputType="number"
            android:padding="12dp"
            android:background="@drawable/shape_10_white"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_add_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:text="添加"
            android:background="@drawable/button_ripple"
            android:textColor="@android:color/black" />

    </LinearLayout>

    <!-- 操作按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_clear_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="一键清空"
            android:layout_margin="4dp"
            android:background="@drawable/button_ripple"
            android:textColor="@android:color/black"
            android:backgroundTint="@android:color/holo_red_light"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="总计: 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="12dp" />

    </LinearLayout>

    <!-- 导入导出按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_export"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="导出数据"
            android:background="@drawable/button_ripple"
            android:textColor="@android:color/black"
            android:backgroundTint="@android:color/holo_green_dark"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_import"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="导入数据"
            android:background="@drawable/button_ripple"
            android:textColor="@android:color/black"
            android:backgroundTint="@android:color/holo_blue_dark" />

    </LinearLayout>


    <!-- 统计列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_statistics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/shape_10_white"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>


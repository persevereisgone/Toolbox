<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_overlay_card_bg"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <TextView
        style="@style/TextAppearance.Toolbox.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请粘贴需要导入的数据文本：" />

    <EditText
        android:id="@+id/et_import_data"
        style="@style/Widget.Toolbox.Input"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="top|start"
        android:hint="粘贴数据文本..."
        android:inputType="textMultiLine"
        android:scrollbars="vertical" />

    <TextView
        style="@style/TextAppearance.Toolbox.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="支持格式：" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/app_card_alt_bg"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <TextView
            style="@style/TextAppearance.Toolbox.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="• 物品名称,数量" />

        <TextView
            style="@style/TextAppearance.Toolbox.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="• 物品名称 数量" />

        <TextView
            style="@style/TextAppearance.Toolbox.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="• 物品名称-数量" />

        <TextView
            style="@style/TextAppearance.Toolbox.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="• 物品名称.数量" />

        <TextView
            style="@style/TextAppearance.Toolbox.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="• 物品名称数量 (无分隔符)" />
    </LinearLayout>
</LinearLayout>
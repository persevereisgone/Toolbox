<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <LinearLayout
        android:id="@+id/tab_cookbooks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xl"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cookbook_library_title"
            style="@style/TextAppearance.Toolbox.TitleLarge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/input_height"
            android:background="@drawable/app_input_border_bg"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_sm">

            <EditText
                android:id="@+id/et_cookbook_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/cookbook_search_hint"
                android:inputType="text"
                android:singleLine="true"
                android:minHeight="@dimen/input_height"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_tertiary"
                android:textSize="@dimen/text_body" />

            <ImageButton
                android:id="@+id/btn_cookbook_search_clear"
                android:layout_width="@dimen/icon_size_lg"
                android:layout_height="@dimen/icon_size_lg"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cookbook_clear_search"
                android:padding="@dimen/space_xxs"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:visibility="gone"
                app:tint="@color/app_text_tertiary" />

            <ImageButton
                android:id="@+id/btn_cookbook_filter"
                android:layout_width="@dimen/icon_size_lg"
                android:layout_height="@dimen/icon_size_lg"
                android:layout_marginStart="@dimen/space_xxs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cookbook_filter"
                android:padding="@dimen/space_xxs"
                android:scaleType="centerInside"
                android:src="@drawable/filter"
                app:tint="@color/app_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_active_filter_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/app_chip_bg"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_xs"
            android:textColor="@color/app_primary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_cookbook_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:text="@string/cookbook_empty_filtered"
            android:textColor="@color/app_text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_clear_cookbook_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/cookbook_clear_filters"
            android:visibility="gone"
            style="@style/Widget.Toolbox.Button.Text" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cookbook_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_md" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_md"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_menu"
            style="@style/TextAppearance.Toolbox.TitleLarge" />

        <TextView
            android:id="@+id/tv_menu_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/empty_menu"
            android:textColor="@color/app_text_secondary"
            android:textSize="@dimen/text_body" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_menu_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1"
            android:background="@drawable/app_card_bg"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_sm"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_md" />

        <Button
            android:id="@+id/btn_clear_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/btn_clear_menu"
            style="@style/Widget.Toolbox.Button.Danger" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_purchase"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_md"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cookbook_purchase_title"
            style="@style/TextAppearance.Toolbox.TitleLarge" />

        <TextView
            android:id="@+id/tv_purchase_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/app_text_secondary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_purchase_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/empty_purchase"
            android:textColor="@color/app_text_secondary"
            android:textSize="@dimen/text_body" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_purchase_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1"
            android:background="@drawable/app_card_bg"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_sm"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_md" />

        <Button
            android:id="@+id/btn_clear_purchased"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/btn_clear_purchased"
            style="@style/Widget.Toolbox.Button.Danger" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_manage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_md"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cookbook_manage_title"
                style="@style/TextAppearance.Toolbox.TitleLarge" />

            <TextView
                android:id="@+id/tv_manage_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/cookbook_manage_count"
                android:textColor="@color/app_text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_custom_cookbook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/cookbook_custom_actions"
            style="@style/Widget.Toolbox.Button.Primary" />

        <Button
            android:id="@+id/btn_import_cookbook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/cookbook_import"
            style="@style/Widget.Toolbox.Button.Secondary" />

        <Button
            android:id="@+id/btn_export_cookbook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/cookbook_export"
            style="@style/Widget.Toolbox.Button.Primary" />

        <Button
            android:id="@+id/btn_download_cookbook_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/cookbook_download_template"
            style="@style/Widget.Toolbox.Button.Text" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/home_card_bg"
        app:menu="@menu/menu_cookbook_bottomnav"
        style="@style/Widget.Toolbox.BottomNavigation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

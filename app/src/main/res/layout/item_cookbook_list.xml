<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/app_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_md">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_cookbook_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="菜谱图标"
            app:shapeAppearance="@style/RoundCornerStyle"
            android:scaleType="centerCrop"
            android:background="@drawable/app_card_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cookbook_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/app_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textColor="@color/app_text_tertiary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_to_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_circle_primary"
            android:backgroundTint="@null"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:padding="0dp"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_xs" />

        <Button
            android:id="@+id/btn_delete_cookbook"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_circle_primary"
            android:backgroundTint="@null"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/app_danger"
            android:textSize="20sp"
            android:padding="0dp"
            android:layout_marginEnd="@dimen/space_xs" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

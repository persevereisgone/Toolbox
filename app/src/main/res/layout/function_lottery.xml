<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/app_hero_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_chip_bg"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="LOTTERY"
                    android:textColor="@color/app_text_inverse"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="转盘抽奖"
                    android:textColor="@color/app_text_inverse"
                    android:textSize="@dimen/text_hero"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="快速切换抽奖组、开始抽奖并查看结果。"
                    android:textColor="@color/home_header_subtitle"
                    android:textSize="@dimen/text_caption_lg" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/home_chip_bg"
                android:contentDescription="返回"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_arrow_back" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Toolbox.CardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/space_lg"
                android:text="当前抽奖组："
                android:textColor="@color/app_text_primary"
                android:textSize="@dimen/text_body_lg" />

            <Spinner
                android:id="@+id/spinner_lottery_group"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_md"
                android:layout_marginEnd="@dimen/space_lg"
                android:layout_weight="1"
                android:background="@drawable/app_input_bg"
                android:paddingStart="@dimen/space_lg" />

            <Button
                android:id="@+id/btn_manage_groups"
                style="@style/Widget.Toolbox.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="管理" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/app_card_bg"
            android:padding="@dimen/space_lg">

            <Yu.code.toolbox.function.lottery.LotteryWheelView
                android:id="@+id/lottery_wheel"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/app_chip_bg"
                android:padding="@dimen/space_xs"
                android:src="@drawable/ic_arrow_drop_down" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/result_area"
            style="@style/Widget.Toolbox.CardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.Toolbox.TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="抽奖结果" />

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/app_chip_bg"
                android:gravity="center"
                android:padding="@dimen/space_xl"
                android:text=""
                android:textColor="@color/app_danger"
                android:textSize="@dimen/text_hero"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start_lottery"
                style="@style/Widget.Toolbox.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_lg"
                android:layout_weight="1"
                android:text="开始抽奖" />

            <Button
                android:id="@+id/btn_reset"
                style="@style/Widget.Toolbox.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="重置" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_manage_items"
            style="@style/Widget.Toolbox.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="管理抽奖内容" />

        <LinearLayout
            style="@style/Widget.Toolbox.SurfaceAlt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Toolbox.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前抽奖组信息" />

            <TextView
                android:id="@+id/tv_group_info"
                style="@style/TextAppearance.Toolbox.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="项目数量: 0" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_md"
        android:background="@drawable/function_page_bg"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <TextView
            style="@style/TextAppearance.Toolbox.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="定时返回桌面" />

        <TextView
            style="@style/TextAppearance.Toolbox.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_md"
            android:text="快速预设 · 自定义时长 · 到点自动回桌面" />

        <TextView
            android:id="@+id/tv_remaining_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textColor="@color/app_primary"
            android:textSize="52sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_timer_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="当前没有正在进行的定时"
            android:textColor="@color/app_text_secondary"
            android:textSize="@dimen/text_body_lg" />

        <!-- 横滑预设条:一行滑完 6 档 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_15min"
                    style="@style/Widget.Toolbox.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_md"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:minWidth="88dp"
                    android:text="15分" />

                <Button
                    android:id="@+id/btn_30min"
                    style="@style/Widget.Toolbox.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_md"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:minWidth="88dp"
                    android:text="30分" />

                <Button
                    android:id="@+id/btn_45min"
                    style="@style/Widget.Toolbox.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_md"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:minWidth="88dp"
                    android:text="45分" />

                <Button
                    android:id="@+id/btn_60min"
                    style="@style/Widget.Toolbox.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_md"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:minWidth="88dp"
                    android:text="1小时" />

                <Button
                    android:id="@+id/btn_90min"
                    style="@style/Widget.Toolbox.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_md"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:minWidth="88dp"
                    android:text="1.5小时" />

                <Button
                    android:id="@+id/btn_120min"
                    style="@style/Widget.Toolbox.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_md"
                    android:minWidth="88dp"
                    android:text="2小时" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            style="@style/Widget.Toolbox.Divider"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_xs" />

        <!-- 自动锁屏行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/button_height_md"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动锁屏"
                    android:textColor="@color/app_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.Toolbox.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:text="到点先回桌面再锁屏 · 需设备管理员权限" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_auto_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:contentDescription="定时结束后自动锁屏开关" />
        </LinearLayout>

        <!-- 自定义时长行 -->
        <LinearLayout
            android:id="@+id/row_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/button_height_md"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自定义时长"
                    android:textColor="@color/app_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.Toolbox.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:text="滚轮选择 · 记住上次" />

                <TextView
                    android:id="@+id/tv_custom_summary"
                    style="@style/TextAppearance.Toolbox.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:text="上次：25分钟" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/app_text_tertiary"
                android:textSize="@dimen/text_title_lg" />
        </LinearLayout>

        <View
            style="@style/Widget.Toolbox.Divider"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_lg" />

        <Button
            android:id="@+id/btn_cancel_timer"
            style="@style/Widget.Toolbox.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_md"
            android:text="取消定时"
            android:textColor="@color/app_danger" />

        <TextView
            style="@style/TextAppearance.Toolbox.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="设置定时后，应用将在指定时间后自动返回桌面，并显示倒计时悬浮窗。" />
    </LinearLayout>
</ScrollView>

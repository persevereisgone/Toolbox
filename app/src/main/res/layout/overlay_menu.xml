<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/app_overlay_card_bg"
    android:elevation="@dimen/elevation_lg"
    android:orientation="vertical"
    android:padding="@dimen/space_sm">

    <TextView
        android:id="@+id/menu_open_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/app_menu_item_bg"
        android:padding="@dimen/space_sm"
        android:text="调整时长"
        android:textColor="@color/app_text_primary"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/menu_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/app_menu_item_bg"
        android:padding="@dimen/space_sm"
        android:text="取消定时"
        android:textColor="@color/app_danger"
        android:textSize="@dimen/text_body" />
</LinearLayout>
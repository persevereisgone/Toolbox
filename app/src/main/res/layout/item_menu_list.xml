<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/app_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/menu_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_md">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_menu_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/tab_menu"
            android:scaleType="centerCrop"
            android:src="@drawable/recipe"
            app:shapeAppearance="@style/RoundCornerStyle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_menu_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/app_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_menu_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textColor="@color/app_text_tertiary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_remove_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="移除"
            style="@style/Widget.Toolbox.Button.Danger" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

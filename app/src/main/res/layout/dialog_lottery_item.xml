<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_overlay_card_bg"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <TextView
        style="@style/TextAppearance.Toolbox.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="项目名称" />

    <EditText
        android:id="@+id/et_item_name"
        style="@style/Widget.Toolbox.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:hint="请输入项目名称" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_md"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Toolbox.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="权重" />

            <EditText
                android:id="@+id/et_item_weight"
                style="@style/Widget.Toolbox.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="1"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Toolbox.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="颜色" />

            <EditText
                android:id="@+id/et_item_color"
                style="@style/Widget.Toolbox.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="#FF6B6B" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.Toolbox.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="提示：权重越大，抽中概率越高" />
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_overlay_card_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="项目名称" android:textColor="@color/app_text_primary" android:textSize="14sp" android:textStyle="bold" />
    <EditText android:id="@+id/et_item_name" style="@style/Widget.Toolbox.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="请输入项目名称" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="权重" android:textColor="@color/app_text_primary" android:textSize="14sp" android:textStyle="bold" />
            <EditText android:id="@+id/et_item_weight" style="@style/Widget.Toolbox.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="1" android:inputType="number" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="颜色" android:textColor="@color/app_text_primary" android:textSize="14sp" android:textStyle="bold" />
            <EditText android:id="@+id/et_item_color" style="@style/Widget.Toolbox.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="#FF6B6B" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="提示：权重越大，抽中概率越高" android:textColor="@color/app_text_secondary" android:textSize="12sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <LinearLayout
        style="@style/Widget.Toolbox.CardContainer.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_status"
            style="@style/TextAppearance.Toolbox.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="准备就绪" />

        <TextView
            style="@style/TextAppearance.Toolbox.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="一键开始录音，停止后自动保存。" />

        <Button
            android:id="@+id/btn_record"
            style="@style/Widget.Toolbox.Button.Primary.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="开始录音" />

        <Button
            android:id="@+id/btn_stop"
            style="@style/Widget.Toolbox.Button.Secondary.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:enabled="false"
            android:text="停止并保存" />
    </LinearLayout>
</LinearLayout>
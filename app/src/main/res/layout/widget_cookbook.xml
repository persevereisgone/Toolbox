<?xml version="1.0" encoding="utf-8"?>
<!-- Cookbook widget: title + 3-line ingredients + primary/secondary actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/bg_widget_m3">
    <TextView android:text="Today" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/widget_on_variant" />
    <TextView android:id="@+id/tv_widget_cook_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Recipe" android:textSize="18sp" android:textStyle="bold"
        android:textColor="@color/widget_on_surface"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/tv_widget_cook_sub"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:maxLines="3" android:ellipsize="end"
        android:textSize="14sp" android:lineSpacingMultiplier="1.5"
        android:textColor="@color/widget_on_variant" />
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <Button android:id="@+id/btn_widget_cook_next"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:text="Next" />
        <Space android:layout_width="8dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_widget_cook_open"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:text="Open" />
    </LinearLayout>
</LinearLayout>

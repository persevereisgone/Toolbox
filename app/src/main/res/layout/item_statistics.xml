<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_lg"
    android:background="@drawable/app_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_lg">

    <TextView
        android:id="@+id/tv_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/space_lg"
        android:textColor="@color/app_text_primary"
        android:textSize="@dimen/text_body_lg"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_decrease"
            style="@style/Widget.Toolbox.Button.Secondary"
            android:layout_width="@dimen/item_height_sm"
            android:layout_height="@dimen/item_height_sm"
            android:layout_marginEnd="@dimen/space_lg"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="-" />

        <TextView
            android:id="@+id/tv_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_lg"
            android:background="@drawable/app_chip_bg"
            android:clickable="true"
            android:gravity="center"
            android:minWidth="@dimen/item_height_sm"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_sm"
            android:textColor="@color/app_primary_dark"
            android:textSize="@dimen/text_body_lg"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_increase"
            style="@style/Widget.Toolbox.Button.Secondary"
            android:layout_width="@dimen/item_height_sm"
            android:layout_height="@dimen/item_height_sm"
            android:layout_marginEnd="@dimen/space_lg"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />

        <Button
            android:id="@+id/btn_delete"
            style="@style/Widget.Toolbox.Button.Secondary"
            android:layout_width="@dimen/item_height_sm"
            android:layout_height="@dimen/item_height_sm"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="×"
            android:textColor="@color/app_danger" />
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_overlay_card_bg"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/app_chip_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_md">

        <TextView
            style="@style/TextAppearance.Toolbox.TitleLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="全部功能" />

        <TextView
            android:id="@+id/tv_all_count"
            style="@style/TextAppearance.Toolbox.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/app_text_tertiary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_all_beta_hint"
        style="@style/TextAppearance.Toolbox.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="正式功能在上，测试中（BETA）在下"
        android:textColor="@color/app_text_tertiary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_all_functions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />
</LinearLayout>

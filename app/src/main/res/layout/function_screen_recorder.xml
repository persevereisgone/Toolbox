<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/app_card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/app_chip_bg"
                android:gravity="center"
                android:padding="14dp"
                android:text="准备就绪"
                android:textColor="@color/app_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_hours"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/app_card_alt_bg"
                    android:gravity="center"
                    android:text="00"
                    android:textColor="@color/app_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:text=":" android:textColor="@color/app_text_primary" android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_minutes"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/app_card_alt_bg"
                    android:gravity="center"
                    android:text="00"
                    android:textColor="@color/app_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:text=":" android:textColor="@color/app_text_primary" android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_seconds"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/app_card_alt_bg"
                    android:gravity="center"
                    android:text="30"
                    android:textColor="@color/app_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/app_card_bg"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button android:id="@+id/btn_hour_minus" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="-时" />
            <Button android:id="@+id/btn_hour_plus" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="+时" />
            <Button android:id="@+id/btn_minute_minus" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="-分" />
            <Button android:id="@+id/btn_minute_plus" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="+分" />
            <Button android:id="@+id/btn_second_minus" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="-秒" />
            <Button android:id="@+id/btn_second_plus" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+秒" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="快捷设置" android:textColor="@color/app_text_primary" android:textSize="16sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/btn_quick_30s" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="30秒" />
            <Button android:id="@+id/btn_quick_1min" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="1分钟" />
            <Button android:id="@+id/btn_quick_5min" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="5分钟" />
            <Button android:id="@+id/btn_quick_10min" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10分钟" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="视频质量" android:textColor="@color/app_text_primary" android:textSize="16sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <Spinner android:id="@+id/spinner_quality" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/app_input_bg" />
            <Spinner android:id="@+id/spinner_fps" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/app_input_bg" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/app_card_bg" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="音频设置（Android 10+）" android:textColor="@color/app_text_primary" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="捕获应用音频" android:textColor="@color/app_text_primary" android:textSize="15sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_app_audio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="只能捕获允许被录制的应用音频，无法捕获系统音效。" android:textColor="@color/app_text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <Button android:id="@+id/btn_start_record" style="@style/Widget.Toolbox.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="开始录屏" />
        <Button android:id="@+id/btn_stop_record" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:enabled="false" android:text="停止录屏" />
        <Button android:id="@+id/btn_view_recordings" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="播放最近录屏" />
        <Button android:id="@+id/btn_view_folder" style="@style/Widget.Toolbox.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="查看录屏文件夹" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义时长 bottom-sheet:抓手 + 双滚轮 + 确定带结果 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_overlay_card_bg"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/app_chip_bg"
        android:importantForAccessibility="no" />

    <TextView
        style="@style/TextAppearance.Toolbox.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_md"
        android:text="自定义时长" />

    <TextView
        style="@style/TextAppearance.Toolbox.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_xs"
        android:text="滚轮选择 · 自动记住上次" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_quick_15"
            style="@style/Widget.Toolbox.Button.Secondary.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:text="15分" />

        <Button
            android:id="@+id/btn_quick_25"
            style="@style/Widget.Toolbox.Button.Secondary.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:text="25分" />

        <Button
            android:id="@+id/btn_quick_45"
            style="@style/Widget.Toolbox.Button.Secondary.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:text="45分" />

        <Button
            android:id="@+id/btn_quick_60"
            style="@style/Widget.Toolbox.Button.Secondary.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1小时" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Toolbox.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小时（0~12）" />

            <NumberPicker
                android:id="@+id/np_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Toolbox.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分钟（0~59）" />

            <NumberPicker
                android:id="@+id/np_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_sheet_error"
        style="@style/TextAppearance.Toolbox.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:text="请选择大于0的时长"
        android:textColor="@color/app_danger"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.Toolbox.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_md"
            android:layout_weight="1"
            android:text="取消" />

        <Button
            android:id="@+id/btn_ok"
            style="@style/Widget.Toolbox.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="确定" />
    </LinearLayout>
</LinearLayout>

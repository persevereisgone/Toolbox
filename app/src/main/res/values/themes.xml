<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Toolbox" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_surface</item>
        <item name="colorPrimaryVariant">@color/app_surface</item>
        <item name="colorOnPrimary">@color/app_text_primary</item>
        <item name="colorSecondary">@color/app_primary</item>
        <item name="colorSecondaryVariant">@color/app_primary_dark</item>
        <item name="colorOnSecondary">@color/app_on_primary</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_surface</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="alertDialogTheme">@style/AppDialogStyle</item>
        <item name="materialAlertDialogTheme">@style/AppDialogStyle</item>
    </style>

    <style name="Theme.Toolbox.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Toolbox.AppBarOverlay" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="android:textColorPrimary">@color/app_text_primary</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
    </style>

    <style name="Theme.Toolbox.PopupOverlay" parent="ThemeOverlay.AppCompat.DayNight">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="colorSurface">@color/app_surface</item>
    </style>
</resources>

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Toolbox" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>
        <!-- 全局对话框主题：淡蓝色圆角 -->
        <item name="alertDialogTheme">@style/AppDialogStyle</item>
        <item name="materialAlertDialogTheme">@style/AppDialogStyle</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Toolbox.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Toolbox.AppBarOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Theme.Toolbox.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:textColor">@color/black</item>
        <item name="colorSurface">@color/white</item>
    </style>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppDialogStyle" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/app_overlay_card_bg</item>
        <item name="backgroundTint">@color/app_surface</item>
    </style>

    <style name="Widget.Toolbox" parent="">
    </style>

    <style name="RoundedCornerShape" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <style name="PopupAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_show</item>
        <item name="android:windowExitAnimation">@anim/popup_hide</item>
    </style>

    <style name="TextAppearance.Toolbox.HeroTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="TextAppearance.Toolbox.Heading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="TextAppearance.Toolbox.HeadingLarge" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_heading_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="TextAppearance.Toolbox.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="TextAppearance.Toolbox.TitleLarge" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_title_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="TextAppearance.Toolbox.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="TextAppearance.Toolbox.BodyLarge" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="TextAppearance.Toolbox.Body.Secondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_caption_lg</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>

    <style name="TextAppearance.Toolbox.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>

    <style name="TextAppearance.Toolbox.Caption.Tertiary" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/app_text_tertiary</item>
    </style>

    <style name="TextAppearance.Toolbox.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Toolbox.CardContainer" parent="Widget.Toolbox">
        <item name="android:background">@drawable/app_card_bg</item>
        <item name="android:padding">@dimen/card_padding_md</item>
        <item name="android:elevation">@dimen/elevation_low</item>
    </style>

    <style name="Widget.Toolbox.CardContainer.Small" parent="Widget.Toolbox.CardContainer">
        <item name="android:padding">@dimen/card_padding_sm</item>
    </style>

    <style name="Widget.Toolbox.CardContainer.Large" parent="Widget.Toolbox.CardContainer">
        <item name="android:padding">@dimen/card_padding_lg</item>
        <item name="android:elevation">@dimen/elevation_md</item>
    </style>

    <style name="Widget.Toolbox.SurfaceAlt" parent="Widget.Toolbox">
        <item name="android:background">@drawable/app_card_alt_bg</item>
        <item name="android:padding">@dimen/card_padding_md</item>
    </style>

    <style name="Widget.Toolbox.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height_md</item>
        <item name="android:textAppearance">@style/TextAppearance.Toolbox.Button</item>
        <item name="android:textColor">@color/app_on_primary</item>
        <item name="android:background">@drawable/button_style</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">@color/app_primary_overlay</item>
    </style>

    <style name="Widget.Toolbox.Button.Primary.Large" parent="Widget.Toolbox.Button.Primary">
        <item name="android:minHeight">@dimen/button_height_lg</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
    </style>

    <style name="Widget.Toolbox.Button.Primary.Small" parent="Widget.Toolbox.Button.Primary">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:paddingHorizontal">@dimen/space_lg</item>
    </style>

    <style name="Widget.Toolbox.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height_md</item>
        <item name="android:textAppearance">@style/TextAppearance.Toolbox.Button</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:background">@drawable/button_ripple</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="rippleColor">@color/app_primary_light</item>
    </style>

    <style name="Widget.Toolbox.Button.Secondary.Large" parent="Widget.Toolbox.Button.Secondary">
        <item name="android:minHeight">@dimen/button_height_lg</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
    </style>

    <style name="Widget.Toolbox.Button.Secondary.Small" parent="Widget.Toolbox.Button.Secondary">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:paddingHorizontal">@dimen/space_lg</item>
    </style>

    <style name="Widget.Toolbox.Button.Danger" parent="Widget.Toolbox.Button.Secondary">
        <item name="android:textColor">@color/app_danger</item>
        <item name="rippleColor">@color/app_danger_light</item>
    </style>

    <style name="Widget.Toolbox.Button.Danger.Large" parent="Widget.Toolbox.Button.Danger">
        <item name="android:minHeight">@dimen/button_height_lg</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
    </style>

    <style name="Widget.Toolbox.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Toolbox.Button</item>
        <item name="android:textColor">@color/app_primary</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="rippleColor">@color/app_primary_light</item>
    </style>

    <style name="Widget.Toolbox.Button.Text.Secondary" parent="Widget.Toolbox.Button.Text">
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="rippleColor">@color/app_surface_soft</item>
    </style>

    <style name="Widget.Toolbox.Input" parent="Widget.Toolbox">
        <item name="android:background">@drawable/app_input_bg</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:paddingBottom">@dimen/space_md</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textColorHint">@color/app_text_tertiary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/input_height</item>
    </style>

    <style name="Widget.Toolbox.Input.Large" parent="Widget.Toolbox.Input">
        <item name="android:minHeight">@dimen/input_height_lg</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
    </style>

    <style name="Widget.Toolbox.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">@dimen/elevation_none</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="itemBackground">@drawable/app_nav_item_bg</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemIconTint">@color/app_nav_icon</item>
        <item name="itemTextColor">@color/app_nav_icon</item>
    </style>

    <style name="Widget.Toolbox.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumbTint">@color/app_primary</item>
        <item name="android:trackTint">@color/app_surface_soft</item>
    </style>

    <style name="Widget.Toolbox.Checkbox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/app_primary</item>
    </style>

    <style name="Widget.Toolbox.RadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:buttonTint">@color/app_primary</item>
    </style>

    <style name="Widget.Toolbox.Divider" parent="">
        <item name="android:background">@color/app_divider</item>
        <item name="android:layout_height">@dimen/stroke_width_thin</item>
    </style>

    <style name="Widget.Toolbox.Divider.Vertical" parent="Widget.Toolbox.Divider">
        <item name="android:layout_width">@dimen/stroke_width_thin</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="Widget.Toolbox.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@color/app_surface_dark</item>
        <item name="android:textColor">@color/app_text_inverse</item>
    </style>

    <style name="Widget.Toolbox.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/app_surface</item>
        <item name="android:elevation">@dimen/elevation_low</item>
        <item name="titleTextColor">@color/app_text_primary</item>
        <item name="subtitleTextColor">@color/app_text_secondary</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
    </style>

    <style name="Widget.Toolbox.Toolbar.Large" parent="Widget.Toolbox.Toolbar">
        <item name="android:minHeight">@dimen/toolbar_height_lg</item>
        <item name="titleTextAppearance">@style/TextAppearance.Toolbox.Heading</item>
    </style>
</resources>